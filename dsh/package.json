{
  "name": "@nomadop/session-watcher-dsh",
  "version": "0.11.2",
  "description": "Session Watcher as a DeepSeek Harness host plugin",
  "type": "module",
  "license": "MIT",
  "author": "Longju Cheng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nomadop/session-watcher.git",
    "directory": "dsh"
  },
  "homepage": "https://nomadop.github.io/session-watcher/docs/dsh/",
  "bugs": {
    "url": "https://github.com/nomadop/session-watcher/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./pi-ai": "./dist/pi-ai-index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "dsh.bundle.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.19.0",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
